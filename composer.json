{
    "name": "jmf/twig-sort",
    "description" : "Twig extension for sorting arrays in Twig templates.",
    "license": "mit",
    "type": "library",
    "require": {
        "php": ">=8.3",
        "jmf/sort": "^1.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "overtrue/phplint": "^9",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^12|^13",
        "rector/rector": "^2",
        "squizlabs/php_codesniffer": "^4"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Jmf\\Twig\\Extension\\Sort\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jmf\\Twig\\Extension\\Sort\\": "tests/src"
        }
    }
}
